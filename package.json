{
  "name": "apto",
  "version": "1.1.0",
  "private": true,
  "description": "Free, unofficial practice app for the Spanish nationality exams (CCSE and DELE A2).",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/validate.mjs && node scripts/build.mjs",
    "start": "npm run build && node scripts/serve.mjs",
    "test": "npm run build && node tests/e2e.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.0",
    "axe-core": "4.10.2"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://getapto.app/"
}
